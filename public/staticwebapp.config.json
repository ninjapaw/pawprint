{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_astro/*", "/*.css", "/*.js", "/*.svg", "/*.png", "/*.webp"]
  },
  "routes": [
    {
      "route": "/api/health",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/admin/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/actions/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/setup/*",
      "statusCode": 404
    },
    {
      "route": "/login*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/legal*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["admin"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/login"
    }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://api.github.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
