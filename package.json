{
  "name": "@ninjapaw/pawprint",
  "version": "0.1.0",
  "description": "Deploy it. Prove it. Leave a pawprint. Reproducible Azure scenarios with portable, auditable evidence for every deploy-detect-remediate run.",
  "license": "MIT",
  "author": "Microsoft Corporation",
  "repository": {
    "type": "git",
    "url": "https://github.com/ninjapaw/pawprint.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/pawprint-setup.mjs",
    "doctor": "node scripts/pawprint-doctor.mjs",
    "connect": "node scripts/pawprint-connect.mjs",
    "uninstall": "node scripts/pawprint-uninstall.mjs",
    "config:check": "node scripts/pawprint-config.mjs --check --environment dev && node scripts/pawprint-config.mjs --check --environment prod",
    "schema:check": "node scripts/validate-schemas.mjs",
    "scenario:check": "node scripts/validate-scenario.mjs samples/*.scenario.json",
    "test:guardrails": "node scripts/test-guardrails.mjs",
    "test:policy": "node scripts/test-scenario-policy.mjs",
    "test:deploy-config": "node scripts/test-deploy-config.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "vendor:check": "node scripts/vendor-sync.mjs --verify-sources",
    "connector:check": "node scripts/check-devops-connector.mjs",
    "platform:status": "node scripts/pawprint-platform.mjs",
    "onboard": "node scripts/pawprint-onboard.mjs",
    "test": "npm run schema:check && npm run config:check && npm run scenario:check && npm run test:guardrails && npm run test:policy && npm run test:deploy-config && npm run vendor:check"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "keywords": [
    "azure",
    "bicep",
    "infrastructure-as-code",
    "github-actions",
    "security",
    "defender-for-cloud",
    "compliance-evidence"
  ]
}
