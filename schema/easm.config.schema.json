{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninjapaw.github.io/pawprint/schema/easm.config.schema.json",
  "title": "Shared EASM desired configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion", "key", "enabled", "environment", "workspaceName", "location",
    "protectFromDeletion", "accessBindings", "budget", "authorizedDomains", "discoveryGroups"
  ],
  "properties": {
    "configVersion": { "const": "1.0.0" },
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,19}$" },
    "enabled": { "type": "boolean" },
    "environment": { "enum": ["dev", "prod"] },
    "workspaceName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,39}$" },
    "location": { "type": "string", "pattern": "^[a-z][a-z0-9]{2,31}$" },
    "protectFromDeletion": { "type": "boolean" },
    "accessBindings": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalId", "principalType", "role"],
        "properties": {
          "principalId": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36 },
          "principalType": { "enum": ["User", "Group", "ServicePrincipal"] },
          "role": { "enum": ["Reader", "Contributor"] }
        }
      }
    },
    "budget": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["monthlyAmount", "contactEmails", "startDate"],
          "properties": {
            "monthlyAmount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "contactEmails": {
              "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
              "items": { "type": "string", "format": "email" }
            },
            "startDate": {
              "type": "string", "format": "date-time",
              "pattern": "^\\d{4}-\\d{2}-01T00:00:00Z$"
            }
          }
        }
      ]
    },
    "authorizedDomains": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": { "type": "string", "format": "hostname" }
    },
    "discoveryGroups": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tier", "frequencyDays", "seeds", "excludes"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,29}$" },
          "tier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "description": { "type": "string", "maxLength": 256, "pattern": "^[^\\r\\n\\u0000]*$" },
          "frequencyDays": { "type": "integer", "minimum": 0, "maximum": 365 },
          "seeds": {
            "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
            "items": { "$ref": "#/$defs/domainSource" }
          },
          "excludes": {
            "type": "array", "maxItems": 100, "uniqueItems": true,
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/domainSource" },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "name"],
                  "properties": { "kind": { "const": "ipBlock" }, "name": { "type": "string", "minLength": 1 } }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "domainSource": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["domain", "host"] },
        "name": { "type": "string", "format": "hostname" }
      }
    }
  }
}
