{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninjapaw.github.io/pawprint/schema/platform-connectors.schema.json",
  "title": "Pawprint platform connector catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "connectors"],
  "properties": {
    "$schema": { "type": "string" },
    "catalogVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "connectors": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{2,63}$" },
      "additionalProperties": { "$ref": "#/$defs/connector" }
    }
  },
  "$defs": {
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "category",
        "provider",
        "automation",
        "detect",
        "permissions",
        "lifecycle",
        "iac",
        "guidance"
      ],
      "properties": {
        "title": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["defender", "identity", "devops", "dns"]
        },
        "provider": {
          "type": "string",
          "enum": [
            "azure",
            "microsoft-entra",
            "github",
            "azure-devops",
            "gitlab",
            "aws",
            "gcp",
            "cloudflare"
          ]
        },
        "automation": {
          "type": "string",
          "enum": ["bicep", "hybrid", "guided"]
        },
        "detect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "azure-security-connector",
                "graph-service-principal",
                "github-enterprise",
                "azure-devops-organization",
                "github-environment-secret"
              ]
            },
            "environmentName": { "type": "string" },
            "displayName": { "type": "string" }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "manage"],
          "properties": {
            "read": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "manage": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "lifecycle": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "scan",
              "onboard",
              "repair",
              "rotate",
              "access",
              "disable",
              "remove"
            ]
          }
        },
        "iac": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shared", "repositoryOwned"],
          "properties": {
            "shared": { "type": "array", "items": { "type": "string" } },
            "repositoryOwned": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "guidance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "manualSteps", "url"],
          "properties": {
            "summary": { "type": "string" },
            "manualSteps": { "type": "array", "items": { "type": "string" } },
            "url": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
