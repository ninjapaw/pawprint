{
  "$comment": "Declares the organisation's intended platform state. pawprint-platform.mjs compares this to reality; everything in it was verified against Azure and GitHub rather than assumed. Subscription ids are deliberately absent, as they are everywhere else: they are supplied at runtime.",
  "manifestVersion": "1.0.0",
  "githubOrganisation": "ninjapaw",
  "organisationVariables": {
    "AZURE_TENANT_ID": "c3b58b46-8d1e-4caf-8089-a2c99bb3fa8c",
    "AZURE_LOCATION": "centralus"
  },
  "environments": {
    "dev": {
      "branch": "dev",
      "subscriptionRef": "dev",
      "platformResourceGroup": "NP-Platform-Dev-CentralUS",
      "hostsDevOpsConnector": true
    },
    "prod": {
      "branch": "main",
      "subscriptionRef": "prod",
      "platformResourceGroup": "NP-Platform-CentralUS",
      "hostsDevOpsConnector": false
    }
  },
  "repositories": {
    "pawprint": {
      "role": "kit",
      "environments": {
        "dev": {
          "resourceGroup": "NP-Platform-Dev-CentralUS",
          "infrastructureApp": "pawprint-dev-infrastructure-github",
          "apiApp": "pawprint-dev-api-github",
          "rbacAdmin": true
        }
      }
    },
    "site": {
      "role": "workload",
      "environments": {
        "dev": {
          "resourceGroup": "NP-NinjaPawsSite-Dev-CentralUS",
          "infrastructureApp": "site-dev-infrastructure-github"
        },
        "prod": {
          "resourceGroup": null,
          "infrastructureApp": null,
          "note": "Production has never been provisioned; the resource group does not exist."
        }
      }
    },
    "m365profiles": {
      "role": "workload",
      "environments": {
        "dev": {
          "resourceGroup": "m365profiles-dev",
          "infrastructureApp": "m365profiles-dev-infrastructure-github"
        },
        "prod": {
          "resourceGroup": "NP-m365profiles-CentralUS",
          "infrastructureApp": "m365profiles-prod-infrastructure-github"
        }
      }
    },
    "sentinel-optimizer": {
      "role": "workload",
      "environments": {
        "dev": {
          "resourceGroup": "NP-SentinelOptimizer-Dev-CentralUS",
          "infrastructureApp": "sentinel-optimizer-dev-infrastructure-github",
          "apiApp": "sentinel-optimizer-dev-api-github",
          "rbacAdmin": true
        },
        "prod": {
          "resourceGroup": "NP-SentinelOptimizer-CentralUS",
          "infrastructureApp": "sentinel-optimizer-prod-infrastructure-github",
          "apiApp": "sentinel-optimizer-prod-api-github",
          "rbacAdmin": true,
          "apiNote": "The production resource group holds only static sites; the API App Service was never provisioned, so there is nothing to scope the API identity to. Grant Website Contributor on the API site once it exists."
        }
      }
    },
    "ninjapaws-cloud-security-dojo": {
      "role": "workload",
      "environments": {
        "dev": {
          "resourceGroup": "NP-ninjapaws-dojo-Dev-CentralUS",
          "infrastructureApp": "ninjapaws-cloud-security-dojo-dev-github",
          "rbacAdmin": true
        },
        "prod": {
          "resourceGroup": "NP-ninjapaws-dojo-Prod-CentralUS",
          "subscriptionRef": "dev",
          "infrastructureApp": "ninjapaws-cloud-security-dojo-prod-github",
          "rbacAdmin": true,
          "note": "Production runs in the development subscription. Deliberate for a training environment that must never share a subscription with production workloads, but it means prod here is not the prod subscription."
        }
      }
    }
  }
}
