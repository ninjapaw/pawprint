metadata description = 'Augment the existing PawPrint portal. Workforce auth, observation grants and shared requests are staged, not enabled by default.'

targetScope = 'resourceGroup'

@description('Globally unique Static Web App name.')
param siteName string

@description('Azure region used for Static Web App resource metadata.')
param location string = resourceGroup().location

@description('Deployment environment.')
@allowed([
  'dev'
  'prod'
])
param environmentName string

@description('Static Web Apps plan. Standard is required for the linked authenticated Functions backend.')
@allowed([
  'Standard'
])
param siteSkuName string = 'Standard'

@description('Function App name for hosted administration.')
param functionAppName string

@description('Key Vault name for the dedicated GitHub App private key.')
param keyVaultName string

@description('Existing shared Log Analytics workspace name.')
param logAnalyticsName string

@description('Existing shared Application Insights resource name.')
param applicationInsightsName string

@description('GitHub App ID. Leave blank until the dedicated app is installed.')
param githubAppId string = ''

@description('GitHub App installation ID. Leave blank until the dedicated app is installed.')
param githubAppInstallationId string = ''

@description('Enable dispatch after the GitHub App key and IDs are configured.')
param githubAppEnabled bool = false

@description('Object ID of the narrow GitHub OIDC identity used for Function code publication.')
param deploymentPrincipalId string

@description('Pinned, non-secret client ID generated by the SWA linked backend provider. Blank leaves existing provider settings untouched and new shared routes closed.')
param linkedBackendClientId string = ''

@description('Allow the API identity to verify its own Easy Auth configuration and the linked SWA backend at runtime.')
param enableBackendVerification bool = false

@description('Explicit subscription mappings and fixed resource bindings. Never pass EASM_CONFIG_JSON, Cloudflare credentials or budget contacts here.')
param portalSources object = {
  subscriptions: {}
  bindings: {}
}

@description('Optional approved metadata Reader grants at resource-group scope only. No subscription-wide Reader is created.')
param observationResourceGroups { subscriptionId: string, resourceGroupName: string }[] = []

@description('Create a private operation-record container in the existing Function runtime storage. No new account or database.')
param enableOperationRecords bool = false

@description('Default-off bounded EASM workflow requests. Protected GitHub workflow gates remain authoritative.')
param sharedActionsEnabled bool = false

@description('Comma-separated dev/prod environments whose current protected EASM configuration has been reviewed. This declaration is not live secret verification.')
param easmReviewedEnvironments string = ''

var portalAuth = loadJsonContent('../../config/portal-auth.json')
var workforceEnabled = portalAuth.mode == 'workforce'

resource authIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2024-11-30' = if (workforceEnabled) {
  name: '${siteName}-workforce'
  location: location
  tags: {
    application: 'pawprint-portal'
    purpose: 'swa-only-workforce-federation'
    'platform.managed': 'true'
  }
}

resource workspace 'Microsoft.OperationalInsights/workspaces@2025-02-01' existing = {
  name: logAnalyticsName
}

resource applicationInsights 'Microsoft.Insights/components@2020-02-02' existing = {
  name: applicationInsightsName
}

module portal './site.bicep' = {
  name: 'pawprint-portal'
  params: {
    siteName: siteName
    location: location
    environmentName: environmentName
    siteSkuName: siteSkuName
    authIdentityResourceIds: workforceEnabled ? [authIdentity.id] : []
  }
}

module api './api.bicep' = {
  name: 'pawprint-portal-api'
  params: {
    functionAppName: functionAppName
    location: location
    environmentName: environmentName
    keyVaultName: keyVaultName
    githubAppId: githubAppId
    githubAppInstallationId: githubAppInstallationId
    githubAppEnabled: githubAppEnabled
    deploymentPrincipalId: deploymentPrincipalId
    applicationInsightsConnectionString: applicationInsights.properties.ConnectionString
    logAnalyticsWorkspaceId: workspace.id
    allowedOrigin: portal.outputs.siteUrl
    staticSiteResourceId: portal.outputs.resourceId
    linkedBackendClientId: linkedBackendClientId
    enableBackendVerification: enableBackendVerification
    workforceEnabled: workforceEnabled
    entraTenantId: portalAuth.tenantId
    entraClientId: portalAuth.clientId
    portalSources: portalSources
    enableOperationRecords: enableOperationRecords
    sharedActionsEnabled: sharedActionsEnabled
    easmReviewedEnvironments: easmReviewedEnvironments
  }
}

module keyVault '../../modules/key-vault/main.bicep' = {
  name: 'pawprint-portal-keyvault'
  params: {
    keyVaultName: keyVaultName
    location: location
    environmentName: environmentName
    application: 'pawprint-portal'
    tier: 'workload'
    enablePurgeProtection: true
    secretsUserPrincipalIds: [api.outputs.managedIdentityPrincipalId]
    logAnalyticsWorkspaceId: workspace.id
    tags: {
      'platform.managed': 'true'
    }
  }
}

resource staticSite 'Microsoft.Web/staticSites@2025-03-01' existing = {
  name: siteName
}

resource authSettings 'Microsoft.Web/staticSites/config@2025-03-01' = if (workforceEnabled) {
  parent: staticSite
  name: 'appsettings'
  properties: union(staticSite.listAppSettings().properties, {
    PORTAL_ENTRA_CLIENT_ID: portalAuth.clientId
    OVERRIDE_USE_MI_FIC_ASSERTION_CLIENTID: authIdentity!.properties.clientId
  })
  dependsOn: [portal]
}

resource reader 'Microsoft.Authorization/roleDefinitions@2022-04-01' existing = {
  scope: subscription()
  name: 'acdd72a7-3385-48ef-bd42-f606fba81ae7'
}

resource linkedConfigurationReader 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (enableBackendVerification) {
  name: guid(staticSite.id, resourceId('Microsoft.Web/sites', functionAppName), reader.id)
  scope: staticSite
  properties: {
    principalId: api.outputs.managedIdentityPrincipalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: reader.id
  }
}

module observationReaders './read-scope.bicep' = [for (approved, index) in observationResourceGroups: {
  name: 'portal-observation-reader-${index}'
  scope: resourceGroup(approved.subscriptionId, approved.resourceGroupName)
  params: {
    principalId: api.outputs.managedIdentityPrincipalId
    assignmentSeed: resourceId('Microsoft.Web/sites', functionAppName)
  }
}]

resource linkedBackend 'Microsoft.Web/staticSites/linkedBackends@2025-03-01' = {
  parent: staticSite
  name: 'production'
  properties: {
    backendResourceId: api.outputs.functionAppId
    region: location
  }
}

output resourceId string = portal.outputs.resourceId
output defaultHostname string = portal.outputs.defaultHostname
output siteUrl string = portal.outputs.siteUrl
output functionAppName string = api.outputs.functionAppName
output functionAppUrl string = api.outputs.functionAppUrl
output keyVaultName string = keyVault.outputs.keyVaultName
output workforceIdentityClientId string = workforceEnabled ? authIdentity!.properties.clientId : ''
output workforceIdentityObjectId string = workforceEnabled ? authIdentity!.properties.principalId : ''
output workforceFederatedCredential object = workforceEnabled ? {
  name: 'pawprint-swa-workforce'
  issuer: '${environment().authentication.loginEndpoint}${portalAuth.tenantId}/v2.0'
  subject: authIdentity!.properties.principalId
  audiences: ['api://AzureADTokenExchange']
} : {}
